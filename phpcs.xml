<?xml version="1.0"?>
<ruleset name="WP-Easter-Egg">
	<description>Coding standards for WP Easter Egg plugin.</description>

	<file>lib</file>
	<file>tests</file>

	<arg value="sp"/>
	<arg value="extensions=php"/>

	<rule ref="Generic.Files.LineLength">
		<properties>
			<property name="absoluteLineLimit" value="120"/>
			<property name="ignoreComments" value="true"/>
		</properties>
	</rule>

	<rule ref="Generic.Formatting.DisallowMultipleStatements"/>
	<rule ref="Generic.Formatting.MultipleStatementAlignment"/>
	<rule ref="Generic.Formatting.NoSpaceAfterCast"/>
	<rule ref="Generic.Formatting.NoSpaceAfterOpeningBrace"/>
	<rule ref="Generic.Formatting.NoSpaceBeforeClosingBrace"/>
	<rule ref="Generic.Formatting.SpaceAfterCast"/>
	<rule ref="Generic.Formatting.SpaceBeforeClosingBrace"/>
	<rule ref="Generic.Formatting.SpaceBeforeSemicolon"/>
	<rule ref="Generic.Formatting.UpperCaseConstantName"/>
	<rule ref="Generic.NamingConventions.ConstructorName"/>
	<rule ref="Generic.NamingConventions.UpperCaseConstantName"/>
	<rule ref="Generic.PHP.DeprecatedFunctions"/>
	<rule ref="Generic.PHP.ForbiddenFunctions"/>
	<rule ref="Generic.PHP.LowerCaseConstant"/>
	<rule ref="Generic.PHP.LowerCaseKeyword"/>
	<rule ref="Generic.PHP.LowerCaseType"/>
	<rule ref="Generic.PHP.NoSilencedErrors"/>
	<rule ref="Generic.PHP.NoUnusedVariables"/>
	<rule ref="Generic.Strings.UnnecessaryStringConcat"/>
	<rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
	<rule ref="Generic.WhiteSpace.ScopeIndent"/>
	<rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>

	<rule ref="Squiz.ControlStructures.ControlSignature"/>
	<rule ref="Squiz.ControlStructures.LowercaseDeclaration"/>
	<rule ref="Squiz.Functions.FunctionDeclarationArgumentSpacing"/>
	<rule ref="Squiz.Functions.FunctionDeclarationSpacing"/>
	<rule ref="Squiz.Functions.FunctionDuplicateArgument"/>
	<rule ref="Squiz.Functions.FunctionOpeningBraceSpacing"/>
	<rule ref="Squiz.Functions.FunctionClosingBraceSpacing"/>
	<rule ref="Squiz.Operators.IncrementDecrementUsage"/>
	<rule ref="Squiz.Operators.ValidLogicalOperators"/>
	<rule ref="Squiz.PHP.NonExecutableCode"/>
	<rule ref="Squiz.PHP.DisallowMultipleAssignments"/>
	<rule ref="Squiz.PHP.EchoedStrings"/>
	<rule ref="Squiz.PHP.LowercasePHPFunctions"/>
	<rule ref="Squiz.PHP.LowercaseStyleKeywords"/>
	<rule ref="Squiz.Strings.DoubleQuoteUsage"/>
	<rule ref="Squiz.Strings.EchoedStrings"/>
	<rule ref="Squiz.WhiteSpace.ControlStructureSpacing"/>
	<rule ref="Squiz.WhiteSpace.FunctionClosingBraceSpacing"/>
	<rule ref="Squiz.WhiteSpace.FunctionOpeningBraceSpacing"/>
	<rule ref="Squiz.WhiteSpace.GlobalKeywordSpacing"/>
	<rule ref="Squiz.WhiteSpace.LanguageConstructSpacing"/>
	<rule ref="Squiz.WhiteSpace.ObjectOperatorSpacing"/>
	<rule ref="Squiz.WhiteSpace.SemicolonSpacing"/>
	<rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>

	<rule ref="WordPress.Security.EscapeOutput"/>
	<rule ref="WordPress.Security.NonceVerification"/>
	<rule ref="WordPress.WP.AlternativeFunctions"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedClasses"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.DeprecatedConstant"/>
	<rule ref="WordPress.WP.YodaConditions"/>
	<rule ref="WordPress.WP.NoGlobalIsAdminCheck"/>
	<rule ref="WordPress.WP.NoGlobalPostCheck"/>
	<rule ref="WordPress.WP.NoGlobalPostDataCheck"/>
	<rule ref="WordPress.WP.NoGlobalPostDataCheck"/>
	<rule ref="WordPress.WP.NoGlobalPostDataCheck"/>
</ruleset>
