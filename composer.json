{
	"name": "mmcachran/wp-easter-egg",
	"description": "Add Easter Eggs to your WordPress site using the Konami code or a custom key sequence.",
	"type": "wordpress-plugin",
	"license": "MIT",
	"homepage": "https://toptaco.co",
	"authors": [
		{
			"name": "mmcachran",
			"role": "Developer"
		},
		{
			"name": "toptaco.co",
			"role": "Sponsor"
		}
	],
	"require": {
		"php": "^7.4 || ^8.0 || ^8.1 || ^8.2 || ^8.3",
		"composer/installers": "^2.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.0",
		"wp-cli/wp-cli-bundle": "^2.0",
		"squizlabs/php_codesniffer": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"roave/security-advisories": "dev-latest"
	},
	"autoload": {
		"classmap": [
			"lib/WPEE_Plugin.php",
			"lib/WPEE_Options.php",
			"lib/WPEE_Meta_Box.php",
			"lib/WPEE_Frontend.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"WP_Easter_Egg\\Tests\\": "tests/phpunit/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-html build/coverage",
		"cs": "phpcs --standard=phpcs.xml lib/",
		"cs:fix": "phpcbf --standard=phpcs.xml lib/",
		"post-install-cmd": [
			"@composer dump-autoload --optimize --classmap-authoritative"
		],
		"post-update-cmd": [
			"@composer dump-autoload --optimize --classmap-authoritative"
		],
		"wordpress:install": "wp core download --version=latest",
		"wordpress:update": "wp core update"
	},
	"config": {
		"optimize-autoloader": true,
		"classmap-authoritative": true,
		"prefer-dist": true,
		"prefer-stable": true,
		"sort-packages": true,
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"bin-links": false
	},
	"extra": {
		"wordpress-install-dir": "wordpress",
		"wp-content-dir": "wp-content",
		"installer-paths": {
			"wordpress/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
			"wordpress/wp-content/themes/{$name}/": ["type:wordpress-theme"]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
